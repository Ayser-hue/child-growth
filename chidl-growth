/* ══════════════════════════════════
   STATE
   ══════════════════════════════════ */
let sex = 'M';
let chartWt = null;
let chartHt = null;

function setSex(s) {
  sex = s;
  document.getElementById('btnM').className = s === 'M' ? 'active' : '';
  document.getElementById('btnF').className = s === 'F' ? 'active' : '';
}

/* ══════════════════════════════════
   HELPERS
   ══════════════════════════════════ */
function calcPct(v, p3, p50, p97) {
  if (v < p3)  return { pct: Math.max(2,  (v / p3) * 14),             zone: 'low'  };
  if (v <= p50) return { pct: 14 + ((v - p3)  / (p50 - p3))  * 36,   zone: 'ok'   };
  if (v <= p97) return { pct: 50 + ((v - p50) / (p97 - p50)) * 36,   zone: 'ok'   };
  return         { pct: Math.min(98, 86 + ((v - p97) / p97) * 12),    zone: 'high' };
}

function zoneColor(z) { return z === 'ok' ? '#1D9E75' : z === 'low' ? '#DC2626' : '#D97706'; }
function zoneText(z, type) {
  if (type === 'w') return z === 'ok' ? 'طبيعي' : z === 'low' ? 'أقل من المعدل' : 'أعلى من المعدل';
  return z === 'ok' ? 'طبيعي' : z === 'low' ? 'قصير القامة' : 'طويل للعمر';
}

/* ══════════════════════════════════
   MAIN ANALYZE FUNCTION
   ══════════════════════════════════ */
function analyze() {
  const name  = document.getElementById('iName').value.trim() || 'الطفل';
  const age   = parseInt(document.getElementById('iAge').value);
  const wt    = parseFloat(document.getElementById('iWt').value);
  const ht    = parseFloat(document.getElementById('iHt').value);
  const err   = document.getElementById('errMsg');

  // Validate
  if (isNaN(age) || age < 0 || age > 60) { err.textContent = '⚠️ العمر يجب أن يكون بين 0 و 60 شهراً'; return; }
  if (isNaN(wt)  || wt  < 1 || wt  > 30) { err.textContent = '⚠️ الوزن يجب أن يكون بين 1 و 30 كيلوغرام'; return; }
  if (isNaN(ht)  || ht  < 40|| ht  > 130){ err.textContent = '⚠️ الطول يجب أن يكون بين 40 و 130 سنتيمتر'; return; }
  err.textContent = '';

  const d   = WHO[sex];
  const idx = Math.min(age, 60);
  const wp  = calcPct(wt, d.wp3[idx], d.wp50[idx], d.wp97[idx]);
  const hp  = calcPct(ht, d.hp3[idx], d.hp50[idx], d.hp97[idx]);
  const bmi = wt / ((ht / 100) ** 2);
  const idealWt = d.wp50[idx];
  const diff    = wt - idealWt;

  // Age string
  const y = Math.floor(age / 12), m = age % 12;
  const ageStr = y > 0
    ? `${y} سنة${m > 0 ? ' و' + m + ' أشهر' : ''}`
    : `${age} شهر`;

  // ── Fill child banner ──
  document.getElementById('rAvatar').textContent = sex === 'M' ? '👦' : '👧';
  document.getElementById('rName').textContent   = name + ' — ' + (sex === 'M' ? 'ذكر' : 'أنثى');
  document.getElementById('rAge').textContent    = 'العمر: ' + ageStr;

  // ── KPIs ──
  document.getElementById('kWt').textContent    = wt.toFixed(1) + ' كغم';
  document.getElementById('kWtS').innerHTML     = `<span style="color:${zoneColor(wp.zone)}">${zoneText(wp.zone,'w')}</span>`;
  document.getElementById('kHt').textContent    = ht.toFixed(1) + ' سم';
  document.getElementById('kHtS').innerHTML     = `<span style="color:${zoneColor(hp.zone)}">${zoneText(hp.zone,'h')}</span>`;
  document.getElementById('kBmi').textContent   = bmi.toFixed(1);
  const bmiInfo = bmi < 14 ? { t:'نقص وزن', c:'#DC2626' }
                : bmi < 18 ? { t:'طبيعي',   c:'#1D9E75' }
                : bmi < 20 ? { t:'زيادة',   c:'#D97706' }
                :             { t:'سمنة',    c:'#DC2626' };
  document.getElementById('kBmiS').innerHTML    = `<span style="color:${bmiInfo.c}">${bmiInfo.t}</span>`;
  document.getElementById('kIdeal').textContent = idealWt.toFixed(1) + ' كغم';
  document.getElementById('kIdealS').innerHTML  = `<span style="color:${Math.abs(diff)<1?'#1D9E75':'#D97706'}">${diff>=0?'+':''}${diff.toFixed(1)} كغم</span>`;

  // ── Gauges ──
  document.getElementById('wFill').style.width      = wp.pct + '%';
  document.getElementById('wFill').style.background = zoneColor(wp.zone);
  document.getElementById('wLabel').textContent     = zoneText(wp.zone,'w');
  document.getElementById('wLabel').style.color     = zoneColor(wp.zone);
  document.getElementById('hFill').style.width      = hp.pct + '%';
  document.getElementById('hFill').style.background = zoneColor(hp.zone);
  document.getElementById('hLabel').textContent     = zoneText(hp.zone,'h');
  document.getElementById('hLabel').style.color     = zoneColor(hp.zone);

  // ── Status banner ──
  const status = buildStatus(wp.zone, hp.zone);
  const sb = document.getElementById('sBanner');
  sb.className = 'status-banner ' + status.bg;
  document.getElementById('sIcon').textContent  = status.icon;
  document.getElementById('sTitle').textContent = status.title;
  document.getElementById('sTitle').style.color = status.color;
  document.getElementById('sDesc').textContent  = status.desc;

  // ── Advice ──
  buildAdvice(name, age, wt, ht, bmi, idealWt, wp.zone, hp.zone);

  // ── Charts ──
  buildCharts(sex, idx, wt, ht);

  // ── Show results ──
  document.getElementById('formSection').style.display = 'none';
  document.getElementById('results').style.display     = 'block';
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

/* ══════════════════════════════════
   STATUS BANNER
   ══════════════════════════════════ */
function buildStatus(wz, hz) {
  if (wz==='low' && hz==='low')
    return { icon:'⚠️', bg:'bg-red-l',   color:'#DC2626', title:'تأخر في النمو — يُنصح بمراجعة الطبيب',
             desc:'كل من الوزن والطول أقل من المعدل الطبيعي. يُنصح بإجراء تقييم طبي شامل ومراجعة التغذية.' };
  if (wz==='low')
    return { icon:'🔔', bg:'bg-amber-l', color:'#D97706', title:'الوزن أقل من الطبيعي',
             desc:'وزن الطفل أقل من المعدل المناسب لعمره. راجع الطبيب لتقييم النظام الغذائي.' };
  if (wz==='high')
    return { icon:'🔔', bg:'bg-amber-l', color:'#D97706', title:'الوزن أعلى من الطبيعي',
             desc:'وزن الطفل أعلى من المعدل. يُنصح بمراجعة نمط التغذية وزيادة النشاط البدني.' };
  if (hz==='low')
    return { icon:'📏', bg:'bg-blue-l',  color:'#2563EB', title:'الطول أقل من المعدل',
             desc:'طول الطفل أقل من المتوقع لعمره. قد يكون طبيعياً وراثياً أو يحتاج متابعة — استشر الطبيب.' };
  return   { icon:'✅', bg:'bg-green-l', color:'#0F6E56', title:'النمو طبيعي وصحي 🎉',
             desc:'وزن الطفل وطوله ضمن المعدلات الطبيعية لمنظمة الصحة العالمية. استمر في المتابعة الدورية.' };
}

/* ══════════════════════════════════
   ADVICE
   ══════════════════════════════════ */
function buildAdvice(name, age, wt, ht, bmi, idealWt, wz, hz) {
  const items = [];

  if (wz==='ok' && hz==='ok')
    items.push({ i:'✅', t: `نمو ${name} ضمن المعدل الطبيعي تماماً — استمر في التغذية المتوازنة والمتابعة الدورية.` });

  if (wz==='low') {
    const d = (idealWt - wt).toFixed(1);
    items.push({ i:'🥗', t: `الوزن أقل من المثالي بـ ${d} كغم — أضف وجبات غنية بالبروتين والسعرات الصحية مثل البيض والحليب والبقوليات.` });
    items.push({ i:'🩺', t: 'راجع طبيب الأطفال للتأكد من عدم وجود سبب طبي لنقص الوزن كفقر الدم أو مشاكل الامتصاص.' });
  }
  if (wz==='high') {
    items.push({ i:'🥦', t: 'قلّل السكريات والمقليات، وأكثر من الخضروات والفواكه الطازجة في وجبات الطفل اليومية.' });
    items.push({ i:'🏃', t: 'شجّع الطفل على اللعب البدني النشط يومياً لمدة لا تقل عن 60 دقيقة.' });
    items.push({ i:'🩺', t: 'استشر الطبيب للتأكد من عدم وجود أسباب هرمونية أو طبية تسبب زيادة الوزن.' });
  }
  if (hz==='low')
    items.push({ i:'🥛', t: 'تأكد من كفاية الكالسيوم وفيتامين D في غذاء الطفل — الحليب ومشتقاته والتعرض المعتدل لأشعة الشمس ضروريان لنمو العظام.' });

  if (age < 6)
    items.push({ i:'🤱', t: 'الرضاعة الطبيعية في الأشهر الأولى هي الغذاء الأمثل — احرص عليها قدر الإمكان.' });
  else if (age < 24)
    items.push({ i:'🍽️', t: 'مرحلة الفطام: ابدأ بالخضروات والفواكه المهروسة تدريجياً مع الاستمرار في الرضاعة الطبيعية.' });
  else
    items.push({ i:'🌈', t: 'في هذه المرحلة التنوع الغذائي مهم جداً — قدّم طعاماً من جميع المجموعات الغذائية يومياً.' });

  items.push({ i:'📅', t: 'يُنصح بزيارة طبيب الأطفال كل 3-6 أشهر لمتابعة منحنى النمو والكشف المبكر عن أي انحراف.' });

  const list = document.getElementById('advList');
  list.innerHTML = items.map(a =>
    `<li><span class="advice-icon">${a.i}</span><span>${a.t}</span></li>`
  ).join('');
}

/* ══════════════════════════════════
   CHARTS
   ══════════════════════════════════ */
function buildCharts(sex, idx, wt, ht) {
  const d = WHO[sex];
  const labels = Array.from({ length: 61 }, (_, i) => i);

  const dotDataWt = labels.map(i => i === idx ? wt : null);
  const dotDataHt = labels.map(i => i === idx ? ht : null);

  const baseOpts = {
    responsive: true, maintainAspectRatio: false,
    plugins: {
      legend: { display: false },
      tooltip: {
        rtl: true,
        callbacks: {
          label: ctx => ctx.dataset.label + ': ' + ctx.parsed.y
        }
      }
    },
    scales: {
      x: {
        title: { display: true, text: 'العمر (أشهر)', color: '#9CA3AF', font: { size: 11 } },
        ticks: { color: '#9CA3AF', callback: v => v % 6 === 0 ? v : '' }
      },
      y: { ticks: { color: '#9CA3AF' } }
    }
  };

  if (chartWt) chartWt.destroy();
  chartWt = new Chart(document.getElementById('cWt'), {
    type: 'line',
    data: {
      labels,
      datasets: [
        { label:'P97', data: d.wp97, borderColor:'#9FE1CB', borderWidth:1.5, pointRadius:0, borderDash:[5,4], fill:false },
        { label:'P50', data: d.wp50, borderColor:'#1D9E75', borderWidth:2.5, pointRadius:0, fill:false },
        { label:'P3',  data: d.wp3,  borderColor:'#9FE1CB', borderWidth:1.5, pointRadius:0, borderDash:[5,4], fill:false },
        { label:'الطفل', data: dotDataWt, borderColor:'#DC2626', backgroundColor:'#DC2626',
          pointRadius: ctx => ctx.dataIndex === idx ? 8 : 0, showLine: false, fill: false }
      ]
    },
    options: { ...baseOpts, scales: { ...baseOpts.scales, y: { ...baseOpts.scales.y, title: { display:true, text:'الوزن (كغم)', color:'#9CA3AF', font:{size:11} } } } }
  });

  if (chartHt) chartHt.destroy();
  chartHt = new Chart(document.getElementById('cHt'), {
    type: 'line',
    data: {
      labels,
      datasets: [
        { label:'P97', data: d.hp97, borderColor:'#93C5FD', borderWidth:1.5, pointRadius:0, borderDash:[5,4], fill:false },
        { label:'P50', data: d.hp50, borderColor:'#2563EB', borderWidth:2.5, pointRadius:0, fill:false },
        { label:'P3',  data: d.hp3,  borderColor:'#93C5FD', borderWidth:1.5, pointRadius:0, borderDash:[5,4], fill:false },
        { label:'الطفل', data: dotDataHt, borderColor:'#DC2626', backgroundColor:'#DC2626',
          pointRadius: ctx => ctx.dataIndex === idx ? 8 : 0, showLine: false, fill: false }
      ]
    },
    options: { ...baseOpts, scales: { ...baseOpts.scales, y: { ...baseOpts.scales.y, title: { display:true, text:'الطول (سم)', color:'#9CA3AF', font:{size:11} } } } }
  });
}

