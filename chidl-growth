    </div>

    <!-- KPI cards -->
    <div class="kpi-row">
      <div class="kpi">
        <div class="kpi-label">الوزن</div>
        <div class="kpi-val" id="kWt"></div>
        <div class="kpi-sub" id="kWtS"></div>
      </div>
      <div class="kpi">
        <div class="kpi-label">الطول</div>
        <div class="kpi-val" id="kHt"></div>
        <div class="kpi-sub" id="kHtS"></div>
      </div>
      <div class="kpi">
        <div class="kpi-label">مؤشر الجسم BMI</div>
        <div class="kpi-val" id="kBmi"></div>
        <div class="kpi-sub" id="kBmiS"></div>
      </div>
      <div class="kpi">
        <div class="kpi-label">الوزن المثالي</div>
        <div class="kpi-val" id="kIdeal"></div>
        <div class="kpi-sub" id="kIdealS"></div>
      </div>
    </div>

    <!-- Status banner -->
    <div class="status-banner" id="sBanner">
      <div class="status-icon" id="sIcon"></div>
      <div>
        <div class="status-title" id="sTitle"></div>
        <div class="status-desc"  id="sDesc"></div>
      </div>
    </div>

    <!-- Gauge bars -->
    <div class="card">
      <div class="card-title"><span>📊</span> موقع الطفل على منحنى النمو</div>

      <div class="gauge-wrap">
        <div class="gauge-top">
          <span class="gauge-name">الوزن للعمر</span>
          <span class="gauge-status" id="wLabel"></span>
        </div>
        <div class="gauge-track"><div class="gauge-fill" id="wFill"></div></div>
        <div class="gauge-ticks">
          <span>ضعيف</span><span>P3</span><span>P50</span><span>P97</span><span>مرتفع</span>
        </div>
      </div>

      <div class="gauge-wrap">
        <div class="gauge-top">
          <span class="gauge-name">الطول للعمر</span>
          <span class="gauge-status" id="hLabel"></span>
        </div>
        <div class="gauge-track"><div class="gauge-fill" id="hFill"></div></div>
        <div class="gauge-ticks">
          <span>قصير</span><span>P3</span><span>P50</span><span>P97</span><span>طويل</span>
        </div>
      </div>
    </div>

    <!-- Weight chart -->
    <div class="card">
      <div class="card-title"><span>📈</span> منحنى الوزن للعمر (WHO)</div>
      <div class="chart-legend">
        <div class="legend-item"><div class="legend-line" style="background:#1D9E75"></div> المئيني 50</div>
        <div class="legend-item"><div class="legend-line" style="background:#9FE1CB;border-top:2px dashed #9FE1CB;height:0"></div> المئيني 3 و 97</div>
        <div class="legend-item"><div class="legend-dot" style="background:#DC2626"></div> الطفل</div>
      </div>
      <div class="chart-container"><canvas id="cWt"></canvas></div>
    </div>

    <!-- Height chart -->
    <div class="card">
      <div class="card-title"><span>📏</span> منحنى الطول للعمر (WHO)</div>
      <div class="chart-legend">
        <div class="legend-item"><div class="legend-line" style="background:#2563EB"></div> المئيني 50</div>
        <div class="legend-item"><div class="legend-line" style="background:#93C5FD;border-top:2px dashed #93C5FD;height:0"></div> المئيني 3 و 97</div>
        <div class="legend-item"><div class="legend-dot" style="background:#DC2626"></div> الطفل</div>
      </div>
      <div class="chart-container"><canvas id="cHt"></canvas></div>
    </div>

    <!-- Advice -->
    <div class="card">
      <div class="card-title"><span>💡</span> التوصيات الطبية</div>
      <ul class="advice-list" id="advList"></ul>
    </div>

    <!-- Subscription CTA -->
    <div class="cta-box">
      <h3>⭐ أعجبك التطبيق؟</h3>
      <p>اشترك للحصول على تحليلات غير محدودة ومتابعة منحنى النمو لأكثر من طفل</p>
      <button class="btn-subscribe" onclick="alert('سيتم ربط هذا بـ Gumroad')">اشترك الآن — 3$ / شهر</button>
    </div>

    <button class="btn-reset" onclick="resetForm()">🔄 تحليل طفل آخر</button>

    <div class="footer">
      صُمِّم بواسطة طبيب أطفال · البيانات من منظمة الصحة العالمية
    </div>
  </div>

</div><!-- /container -->

