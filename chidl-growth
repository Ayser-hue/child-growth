<!-- HEADER -->
<header class="app-header">
  <div class="app-logo">🌱</div>
  <div class="app-header-text">
    <h1>متابعة نمو الطفل</h1>
    <p>معايير منظمة الصحة العالمية · WHO 2006</p>
  </div>
</header>

<div class="container">

  <!-- ── FORM SECTION ── -->
  <div id="formSection">
    <div class="card">
      <div class="card-title"><span>📋</span> بيانات الطفل</div>
      <div class="form-grid">

        <div class="field form-full">
          <label>اسم الطفل</label>
          <input type="text" id="iName" placeholder="مثال: أحمد أو سارة" />
        </div>

        <div class="field form-full">
          <label>الجنس</label>
          <div class="seg-wrap">
            <button class="active" id="btnM" onclick="setSex('M')">👦 ذكر</button>
            <button id="btnF" onclick="setSex('F')">👧 أنثى</button>
          </div>
        </div>

        <div class="field">
          <label>العمر بالأشهر</label>
          <input type="number" id="iAge" min="0" max="60" placeholder="مثال: 24" />
          <span class="hint">من 0 حتى 60 شهراً</span>
        </div>

        <div class="field">
          <label>الوزن (كيلوغرام)</label>
          <input type="number" id="iWt" min="1" max="30" step="0.1" placeholder="مثال: 12.5" />
        </div>

        <div class="field form-full">
          <label>الطول (سنتيمتر)</label>
          <input type="number" id="iHt" min="40" max="130" step="0.1" placeholder="مثال: 86" />
        </div>

      </div>
      <button class="btn-analyze" onclick="analyze()">🔍 تحليل النمو</button>
      <div class="error-msg" id="errMsg"></div>
    </div>

    <!-- CTA free trial -->
    <div class="cta-box">
      <h3>🎯 نسخة مجانية للتجربة</h3>
      <p>استمتع بتحليل واحد مجاني — للمزيد اشترك في الخطة الشهرية</p>
      <button class="btn-subscribe" onclick="alert('سيتم ربط هذا بـ Gumroad لاحقاً')">اشترك الآن — 3$ / شهر</button>
    </div>

    <div class="footer">
      صُمِّم بواسطة طبيب أطفال · البيانات من منظمة الصحة العالمية
    </div>
  </div>

  <!-- ── RESULTS SECTION ── -->
  <div id="results">

    <!-- Child banner -->
